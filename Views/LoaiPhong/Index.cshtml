
@model IEnumerable<HotelBookingWebsite.Models.LoaiPhong>

@{
    ViewBag.Title = "Danh sách loại phòng";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Danh sách loại phòng</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container" style="margin-top: 30px;">
        <h2>DANH SÁCH LOẠI PHÒNG</h2>

        <p>
            @Html.ActionLink("Thêm loại phòng", "Create",
                null, new { @class = "btn btn-primary" })
        </p>

        <table class="table table-bordered table-striped">
            <tr>
                <th>Mã loại</th>
                <th>Tên loại phòng</th>
                <th>Đơn giá</th>
                <th>Mô tả</th>
                <th>Chức năng</th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaLoai</td>
                    <td>@item.TenLoai</td>
                    <td>@item.DonGia</td>
                    <td>@item.MoTa</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.MaLoai }) |
                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.MaLoai })
                    </td>
                </tr>
            }
        </table>
    </div>
</body>
</html>
