
@model HotelBookingWebsite.Models.LoaiPhong

@{
    ViewBag.Title = "Thêm loại phòng";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thêm loại phòng</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container" style="margin-top: 30px;">
        <h2>THÊM LOẠI PHÒNG</h2>
        <hr />

        @using (Html.BeginForm())
        {
            <div class="form-group">
                <label>Tên loại phòng</label>
                @Html.TextBoxFor(m => m.TenLoai,
                         new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Đơn giá</label>
                @Html.TextBoxFor(m => m.DonGia,
                         new { @class = "form-control", type = "number", step = "0.01" })
            </div>

            <div class="form-group">
                <label>Mô tả</label>
                @Html.TextAreaFor(m => m.MoTa,
                         new { @class = "form-control", rows = "3" })
            </div>

            <br />

            <button type="submit" class="btn btn-primary">
                Thêm loại phòng
            </button>

            @Html.ActionLink("Quay lại", "Index",
                     null, new { @class = "btn btn-default" })
        }
    </div>
</body>
</html>
